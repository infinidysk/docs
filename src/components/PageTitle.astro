---
import { Badge } from '@astrojs/starlight/components';
// Not in the package exports; starlight-page-actions is pinned in package.json so this path stays valid.
import PageActions from '../../node_modules/starlight-page-actions/components/PageActions.astro';

const { id, entry } = Astro.locals.starlightRoute;
const version = { v1: '1.x', v2: '2.x' }[id.split('/')[0]];
// Changelog pages are generated from a remote file, so they have no Markdown copy.
const showActions = !id.startsWith('v1/changelog');
// Pre-selects this page's version in search once per page load; the reader can clear it.
const preselect = `(() => {
	const version = document.currentScript.dataset.version;
	const dialog = document.querySelector('site-search dialog');
	if (!dialog) return;
	new MutationObserver((_, observer) => {
		const box = dialog.querySelector('#version-' + CSS.escape(version));
		if (!box) return;
		observer.disconnect();
		if (!box.checked) box.click();
	}).observe(dialog, { childList: true, subtree: true });
})();`;
---

<h1 id="_top" data-pagefind-filter={version ? `version:${version}` : undefined}>
	{entry.data.title}
	{version && <Badge text={version} variant={version === '2.x' ? 'caution' : 'note'} class="version-badge" />}
</h1>
{
	showActions && (
		<div class="page-actions-fallback">
			<PageActions />
		</div>
	)
}
{version && <script is:inline data-version={version} set:html={preselect} />}

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	h1 :global(.version-badge) {
		vertical-align: middle;
		margin-inline-start: 0.5rem;
	}
	.page-actions-fallback {
		margin-top: 1rem;
	}
	@media (min-width: 50rem) {
		/* The sidebar topic already says which version this is. */
		h1 :global(.version-badge) {
			display: none;
		}
	}
	@media (min-width: 72rem) {
		.page-actions-fallback {
			display: none;
		}
	}
</style>
