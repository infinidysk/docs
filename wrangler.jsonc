{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "infinidysk-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.infinidysk.com", "custom_domain": true },
    {
      "pattern": "preview.infinidysk.com",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ],
  "workers_dev": false,
  "previews": {}
}
